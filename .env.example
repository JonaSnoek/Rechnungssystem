# ---------------------------------------------------------------------------
# Beispiel-Konfiguration fuer das PayPal Verzehrabrechnungssystem
#
# Kopieren nach .env und anpassen:
#     cp .env.example .env
#
# WICHTIG: Diese Datei NIE ins Git-Repository committen.
#           Sie ist bereits in .gitignore eingetragen.
# ---------------------------------------------------------------------------

# --- Anwendung ------------------------------------------------------------
APP_NAME="Verzehrabrechnung"
APP_ENV=production            # development | production
# Standard ist bewusst nur das Loopback-Interface: im Betrieb steht nginx
# davor. Fuer direkten LAN-Zugriff auf 0.0.0.0 setzen - und zusaetzlich in
# /etc/systemd/system/verzehr-web.service das --bind anpassen, weil Gunicorn
# dort seine eigene Bind-Adresse aus der Unit-Datei nimmt.
APP_HOST=127.0.0.1
APP_PORT=8000
SECRET_KEY=                   # wird bei Erstinstallation automatisch erzeugt
APP_URL=http://localhost:8000 # oeffentliche Basis-URL (fuer Links in E-Mails)

# --- Datenbank ------------------------------------------------------------
# Reihenfolge der Aufloesung:
#   1. echte Umgebungsvariable (systemd/shell) - hat Vorrang und laesst sich
#      im Einrichtungsassistenten deshalb nicht aendern
#   2. instance/secrets.env  (im Assistenten gewaehlt)
#   3. diese .env-Datei
#   4. Vorgabe: sqlite in instance/
DATABASE_URL=sqlite:////var/lib/verzehr/instance/payment.db
# PostgreSQL Alternative (Treiber nachinstallieren: pip install psycopg2-binary):
# DATABASE_URL=postgresql+psycopg2://paypal:SECRET@127.0.0.1:5432/verzehr

# --- PayPal ---------------------------------------------------------------
PAYPAL_ME_USERNAME=
PAYPAL_CURRENCY=EUR

# --- Abrechnung -----------------------------------------------------------
AUTO_BILLING_ENABLED=true
AUTO_BILLING_TIME=17:00
APP_TIMEZONE=Europe/Berlin
# Bei mehreren Gunicorn-Workern auf false setzen und stattdessen
# verzehr-scheduler.service betreiben (macht install.sh so).
SCHEDULER_ENABLED=true
# Hinweis: AUTO_BILLING_* und die Zeitzone werden im Assistenten in der
# Datenbank gesetzt. Die Variablen hier sind nur die Voreinstellung.

# --- SMTP / E-Mail --------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=starttls        # none | starttls | ssl
SMTP_USERNAME=
SMTP_PASSWORD=                 # GEHEIM - niemals committen
SMTP_TIMEOUT=30
MAIL_FROM_NAME=Abrechnung
MAIL_FROM_ADDRESS=abrechnung@example.com

# --- Betrieb --------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=                       # leer = nur Konsole
WORKERS=2
