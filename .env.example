# ---------------------------------------------------------------------------
# Beispiel-Konfiguration fuer das PayPal Verzehrabrechnungssystem
#
# Kopieren nach .env und anpassen:
#     cp .env.example .env
#
# WICHTIG: Diese Datei NIE ins Git-Repository committen.
#           Sie ist bereits in .gitignore eingetragen.
#
# WICHTIG: KEINE Kommentare hinter einem Wert schreiben.
#
#   FALSCH:  SMTP_PORT=587  # der Standardport
#   RICHTIG:  # der Standardport
#             SMTP_PORT=587
#
# Grund: systemd laedt diese Datei ueber "EnvironmentFile=" ein, bevor Python
# startet. Dessen Parser nimmt alles nach dem ersten "=" als Wert - er
# schneidet keinen Kommentar ab. "SMTP_PASSWORD=x # Geheim" waere danach
# das Passwort "x # Geheim". Eine Umgebungsvariable schlaegt ausserdem
# jede Eingabe in der Weboberflaeche, das Passwort waere also nicht mehr
# aenderbar. Kommentare gehoeren deshalb in eigene Zeilen.
# ---------------------------------------------------------------------------

# --- Anwendung ------------------------------------------------------------
APP_NAME="Verzehrabrechnung"
# development oder production
APP_ENV=production
# Nur wirksam fuer den Entwicklungsserver ('python wsgi.py'). Der Betrieb
# laeuft ueber systemd, und Gunicorn nimmt seine Bind-Adresse aus der
# Unit-Datei /etc/systemd/system/verzehr-web.service (--bind). Beide Werte
# setzt install.sh ueber BIND_ADDR, Standard 0.0.0.0, damit die Anwendung
# unter der IP des Servers erreichbar ist. Hinter nginx bitte auf
# 127.0.0.1 umstellen.
APP_HOST=127.0.0.1
APP_PORT=8000
# wird bei Erstinstallation automatisch erzeugt
SECRET_KEY=
# oeffentliche Basis-URL, fuer Links in E-Mails
APP_URL=http://localhost:8000

# --- Datenbank ------------------------------------------------------------
# Reihenfolge der Aufloesung:
#   1. echte Umgebungsvariable (systemd/shell) - hat Vorrang und laesst sich
#      im Einrichtungsassistenten deshalb nicht aendern
#   2. instance/secrets.env  (im Assistenten gewaehlt)
#   3. diese .env-Datei
#   4. Vorgabe: sqlite in instance/
DATABASE_URL=sqlite:////var/lib/verzehr/instance/payment.db
# PostgreSQL Alternative (Treiber nachinstallieren: pip install psycopg2-binary):
# DATABASE_URL=postgresql+psycopg2://paypal:SECRET@127.0.0.1:5432/verzehr

# --- PayPal ---------------------------------------------------------------
PAYPAL_ME_USERNAME=
PAYPAL_CURRENCY=EUR

# --- Abrechnung -----------------------------------------------------------
AUTO_BILLING_ENABLED=true
AUTO_BILLING_TIME=17:00
APP_TIMEZONE=Europe/Berlin
# Bei mehreren Gunicorn-Workern auf false setzen und stattdessen
# verzehr-scheduler.service betreiben (macht install.sh so).
SCHEDULER_ENABLED=true
# Hinweis: AUTO_BILLING_* und die Zeitzone werden im Assistenten in der
# Datenbank gesetzt. Die Variablen hier sind nur die Voreinstellung.

# --- SMTP / E-Mail --------------------------------------------------------
# Zuverlaessige Werte fuer Gmail:
#   smtp.gmail.com, Port 587, Verschluesselung starttls
#   Benutzername und Absender muessen die volle Gmail-Adresse sein.
SMTP_HOST=
SMTP_PORT=587
# starttls, ssl oder none
SMTP_ENCRYPTION=starttls
SMTP_USERNAME=
# GEHEIM, niemals committen. Leer lassen und in den Einstellungen eintragen,
# dann landet es in instance/secrets.env.
SMTP_PASSWORD=
SMTP_TIMEOUT=30
MAIL_FROM_NAME=Abrechnung
MAIL_FROM_ADDRESS=abrechnung@example.com

# --- Betrieb --------------------------------------------------------------
LOG_LEVEL=INFO
# leer lassen, dann nur Konsole
LOG_FILE=
WORKERS=2
